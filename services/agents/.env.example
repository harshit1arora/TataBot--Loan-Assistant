ENV=development
LOG_LEVEL=INFO

# --- how the agent service reaches the tool server ------------------------
# http = a running tool server; inmemory = import the server (tests, single process)
MCP_TRANSPORT=http
MCP_URL=http://localhost:8765/mcp

# --- model provider ------------------------------------------------------
# rules | groq | gemini
LLM_PROVIDER=groq
GROQ_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=12
LLM_MAX_OUTPUT_TOKENS=500
MAX_WORKERS_PER_TURN=2

# --- one key per role ----------------------------------------------------
# Each role gets its own Groq key so a burst on one agent cannot exhaust the quota the
# router needs. Fill these in your local .env only — never commit them.
#
#   GROQ_API_KEY_ROUTER       the orchestrator that decides which agents run
#   GROQ_API_KEY_ELIGIBILITY  the eligibility agent
#   GROQ_API_KEY_INTEREST     the interest / EMI agent
#   GROQ_API_KEY_DOCUMENT     the document-verification agent
#   GROQ_API_KEY_FAQ          the FAQ agent
#
# A role with no key of its own falls back to GROQ_API_KEY. With no keys at all the
# service runs on the deterministic rule router, which is a supported mode, not an error.
GROQ_API_KEY_ROUTER=
GROQ_API_KEY_ELIGIBILITY=
GROQ_API_KEY_INTEREST=
GROQ_API_KEY_DOCUMENT=
GROQ_API_KEY_FAQ=
GROQ_API_KEY=

# Gemini alternative (ignored when LLM_PROVIDER=groq)
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- service auth --------------------------------------------------------
AGENT_SERVICE_TOKEN=replace-me-agent-token
MAX_QUESTION_CHARS=1000
