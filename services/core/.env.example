# Copy to .env and fill in. Never commit the real .env.
ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=core-service

# --- persistence ---------------------------------------------------------
DATABASE_URL=sqlite:///./data/core.db
# DATABASE_URL=postgresql+psycopg://tatabot:tatabot@localhost:5432/tatabot
DB_ECHO=false

# --- auth ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-me-with-a-48-byte-random-string-minimum-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_SECONDS=900
SERVICE_TOKEN_TTL_SECONDS=300
SERVICE_CLIENT_ID=conversation-service
SERVICE_CLIENT_SECRET=replace-me-with-a-random-string
# Demo login skips OTP. MUST be false in production (the app refuses to boot otherwise).
ALLOW_DEMO_AUTH=true
SIGNED_URL_TTL_SECONDS=60

# --- http ----------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8080
RATE_LIMIT_PER_MINUTE=120
# Set true only when the service sits behind a proxy you control.
TRUST_PROXY_HEADERS=false

# --- storage -------------------------------------------------------------
# local = a directory on disk (containers, local dev).
# s3    = any S3-compatible bucket. REQUIRED on serverless (Vercel, Lambda).
STORAGE_BACKEND=local
STORAGE_DIR=./data/storage
S3_BUCKET=
S3_PREFIX=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=
# Bucket credentials come from the standard AWS chain, never from this file:
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY, or an instance/OIDC role.
MAX_UPLOAD_BYTES=5242880
ALLOWED_UPLOAD_TYPES=application/pdf,image/jpeg,image/png
MIN_EXTRACTION_CONFIDENCE=0.75
# auto | rapidocr | tesseract | disabled — OCR for images and scanned PDFs
OCR_PROVIDER=auto
OCR_MIN_CONFIDENCE=0.55

# --- credit policy (single source of truth) ------------------------------
POLICY_VERSION=2026.10-v1
MIN_CREDIT_SCORE=700
MAX_EMI_TO_INCOME_RATIO=0.50
PRE_APPROVED_MULTIPLE=2.0
MIN_LOAN_AMOUNT_RUPEES=10000
MAX_LOAN_AMOUNT_RUPEES=5000000
MIN_TENURE_MONTHS=6
MAX_TENURE_MONTHS=60
DEFAULT_TENURE_MONTHS=36
ANNUAL_RATE_PERCENT=12.0
MIN_CUSTOMER_AGE=21
MAX_CUSTOMER_AGE=60
