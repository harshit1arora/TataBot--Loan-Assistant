ENV=development
LOG_LEVEL=INFO
SERVICE_NAME=conversation-service

DATABASE_URL=sqlite:///./data/conversation.db

# Must match the core service: this service verifies the tokens it issues.
JWT_SECRET=replace-me-with-a-48-byte-random-string-minimum-32-chars
JWT_ALGORITHM=HS256
JWT_ISSUER=core-service
JWT_AUDIENCE=tatabot-api

CORE_BASE_URL=http://localhost:8000
CORE_TIMEOUT_SECONDS=5
CORE_MAX_RETRIES=2
CORE_CLIENT_ID=conversation-service
CORE_CLIENT_SECRET=replace-me-with-a-random-string

# The service works fully with the LLM disabled: replies come from templates.
LLM_ENABLED=false
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TIMEOUT_SECONDS=8
LLM_MAX_OUTPUT_TOKENS=160
MAX_LLM_CALLS_PER_SESSION=12

# Questions are delegated to the LangGraph agent service; statements stay in the
# deterministic application flow.
AGENTS_ENABLED=true
AGENTS_BASE_URL=http://localhost:8004
AGENTS_SERVICE_TOKEN=replace-me-agent-token
AGENTS_TIMEOUT_SECONDS=20

ALLOWED_ORIGINS=http://localhost:8080
RATE_LIMIT_PER_MINUTE=120
MAX_MESSAGE_CHARS=1000
