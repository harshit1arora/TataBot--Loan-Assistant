{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd apps/web && npm run build",
  "outputDirectory": "apps/web/dist",
  "installCommand": "cd apps/web && npm ci",
  "functions": {
    "api/core.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "services/core/**"
    },
    "api/conversation.py": {
      "maxDuration": 60,
      "memory": 1024,
      "includeFiles": "services/conversation/**"
    }
  },
  "rewrites": [
    {
      "source": "/identity",
      "destination": "/index.html"
    },
    {
      "source": "/scenarios",
      "destination": "/index.html"
    },
    {
      "source": "/review",
      "destination": "/index.html"
    },
    {
      "source": "/chat",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": ".*text/html.*"
        }
      ],
      "destination": "/index.html"
    },
    {
      "source": "/login",
      "destination": "/index.html"
    },
    {
      "source": "/status",
      "destination": "/index.html"
    },
    {
      "source": "/api/core/:path+",
      "destination": "/api/core?__route=/:path+"
    },
    {
      "source": "/api/conversation/:path+",
      "destination": "/api/conversation?__route=/:path+"
    },
    {
      "source": "/auth/:path*",
      "destination": "/api/core?__route=/auth/:path*"
    },
    {
      "source": "/v1/:path*",
      "destination": "/api/core?__route=/v1/:path*"
    },
    {
      "source": "/download/:path*",
      "destination": "/api/core?__route=/download/:path*"
    },
    {
      "source": "/chat",
      "destination": "/api/conversation?__route=/chat"
    },
    {
      "source": "/sessions/:path*",
      "destination": "/api/conversation?__route=/sessions/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
