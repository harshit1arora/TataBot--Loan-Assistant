# Root environment for docker compose. Copy to .env and replace both secrets.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# demo     = demo login allowed, safe to expose as a public demonstration
# production = demo login refused at boot; real OTP/KYC required
ENV=demo
LOG_LEVEL=INFO

# --- shared secrets -------------------------------------------------------
# Must be identical in both services: the conversation service verifies the
# tokens the core service issues.
JWT_SECRET=replace-me-with-a-48-byte-random-string-minimum-32-chars
SERVICE_CLIENT_ID=conversation-service
SERVICE_CLIENT_SECRET=replace-me-with-a-second-random-string

# --- database -------------------------------------------------------------
POSTGRES_USER=tatabot
POSTGRES_PASSWORD=replace-me
POSTGRES_DB=tatabot

# --- auth -----------------------------------------------------------------
# Demo login skips OTP. Keep false in production: the core service refuses to
# start with env=production and this set to true.
ALLOW_DEMO_AUTH=true
ACCESS_TOKEN_TTL_SECONDS=900
SERVICE_TOKEN_TTL_SECONDS=300
SIGNED_URL_TTL_SECONDS=60

# --- http -----------------------------------------------------------------
ALLOWED_ORIGINS=http://localhost:8080
RATE_LIMIT_PER_MINUTE=120
# Set true only when the service sits behind a proxy you control.
TRUST_PROXY_HEADERS=false

# --- uploads --------------------------------------------------------------
MAX_UPLOAD_BYTES=5242880
MIN_EXTRACTION_CONFIDENCE=0.75

# --- storage (set to s3 on any serverless platform) -----------------------
STORAGE_BACKEND=local
S3_BUCKET=
S3_PREFIX=
S3_REGION=ap-south-1
S3_ENDPOINT_URL=

# --- credit policy --------------------------------------------------------
POLICY_VERSION=2026.10-v1
MIN_CREDIT_SCORE=700
MAX_EMI_TO_INCOME_RATIO=0.50
PRE_APPROVED_MULTIPLE=2.0
ANNUAL_RATE_PERCENT=12.0

# --- platform services ----------------------------------------------------
MOCK_CRM_TOKEN=replace-me-crm-token
MOCK_OFFERMART_TOKEN=replace-me-offermart-token
AGENT_SERVICE_TOKEN=replace-me-agent-token
CORE_CLIENT_ID=conversation-service

# --- agent layer ----------------------------------------------------------
# How the agent service reaches the MCP tool server: http (containers) or inmemory (tests).
MCP_TRANSPORT=http
MCP_URL=http://mcp-server:8765/mcp
# rules = no model (deterministic router). groq = Llama 3.3. gemini = Gemini.
LLM_PROVIDER=rules
GROQ_MODEL=openai/gpt-oss-20b
# One key per role (router + four agents). Leave blank to use the shared key, or to run
# on the deterministic rule router. Never commit real keys — see .gitignore.
GROQ_API_KEY_ROUTER=
GROQ_API_KEY_ELIGIBILITY=
GROQ_API_KEY_INTEREST=
GROQ_API_KEY_DOCUMENT=
GROQ_API_KEY_FAQ=
GROQ_API_KEY=
MAX_WORKERS_PER_TURN=2

# --- OCR ------------------------------------------------------------------
# auto | rapidocr | tesseract | disabled
OCR_PROVIDER=auto
OCR_MIN_CONFIDENCE=0.55

# --- llm (optional) -------------------------------------------------------
# Leave disabled and the assistant still works: replies come from templates.
LLM_ENABLED=false
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
